# Copy this file to .env and fill in the values. .env is git-ignored.

# PostgreSQL connection. Create the database first:  CREATE DATABASE informed_trades;
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/informed_trades

# Free key from https://finnhub.io (used only by the news ingestion script)
FINNHUB_API_KEY=

# Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# API server
PORT=3001
DEMO_USER_EMAIL=demo@informedtrades.local
